# --- Opzioni Globali ---
font=monospace 10
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
border-radius=8
progress-color=over #25252f

# Posizionamento e Dimensioni
anchor=top-right
width=300
height=110
margin=10
padding=15
layer=overlay

# Comportamento e Icone
sort=-time
max-history=5
default-timeout=5000
icons=1
max-icon-size=64

# --- Interazioni (Mouse/Touch) ---
on-button-left=dismiss
on-button-middle=none
on-button-right=invoke-default-action

# --- Criteri Specifici (Es. Notifiche urgenti) ---
[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
